---
/** Decorative particle network that gently follows the pointer. */
---
<hero-canvas aria-hidden="true">
  <canvas></canvas>
  <span class="probe"></span>
</hero-canvas>

<script>
  class HeroCanvas extends HTMLElement {
    static observedAttributes = ['paused'];
    raf = 0;
    visible = true;
    still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    draw = () => {};
    /** Animate only while visible, not paused and motion is allowed. */
    run() {
      cancelAnimationFrame(this.raf);
      if (this.visible && !this.still && !this.hasAttribute('paused')) this.raf = requestAnimationFrame(this.draw);
    }
    attributeChangedCallback() { this.run(); }
    connectedCallback() {
      const cv = this.querySelector('canvas')!;
      const c = cv.getContext('2d')!;
      const probe = this.querySelector<HTMLElement>('.probe')!;
      const moving = () => !this.still && !this.hasAttribute('paused');
      let W = 0, H = 0, color = '#6d5cf0';
      const mouse = { x: -999, y: -999 };
      type P = { x: number; y: number; vx: number; vy: number; r: number };
      let ps: P[] = [];

      const resize = () => {
        const dpr = Math.min(devicePixelRatio || 1, 2);
        W = this.clientWidth; H = this.clientHeight;
        cv.width = W * dpr; cv.height = H * dpr;
        c.setTransform(dpr, 0, 0, dpr, 0, 0);
        const n = Math.round(Math.min(90, (W * H) / 11000));
        ps = Array.from({ length: n }, () => ({
          x: Math.random() * W, y: Math.random() * H,
          vx: (Math.random() - 0.5) * 0.35, vy: (Math.random() - 0.5) * 0.35,
          r: 1.2 + Math.random() * 2,
        }));
        color = getComputedStyle(probe).color;
      };
      const draw = () => {
        c.clearRect(0, 0, W, H);
        for (const p of ps) {
          if (moving()) {
            p.x += p.vx; p.y += p.vy;
            if (p.x < 0 || p.x > W) p.vx *= -1;
            if (p.y < 0 || p.y > H) p.vy *= -1;
            const dx = p.x - mouse.x, dy = p.y - mouse.y, d = Math.hypot(dx, dy);
            if (d < 120) { p.x += (dx / d) * 0.8; p.y += (dy / d) * 0.8; }
          }
        }
        c.strokeStyle = color;
        for (let i = 0; i < ps.length; i++) {
          for (let j = i + 1; j < ps.length; j++) {
            const a = ps[i], b = ps[j];
            const d = Math.hypot(a.x - b.x, a.y - b.y);
            if (d < 120) {
              c.globalAlpha = (1 - d / 120) * 0.35;
              c.beginPath(); c.moveTo(a.x, a.y); c.lineTo(b.x, b.y); c.stroke();
            }
          }
        }
        c.fillStyle = color;
        for (const p of ps) {
          c.globalAlpha = 0.7;
          c.beginPath(); c.arc(p.x, p.y, p.r, 0, Math.PI * 2); c.fill();
        }
        c.globalAlpha = 1;
        if (moving()) this.raf = requestAnimationFrame(draw);
      };
      this.draw = draw;

      resize();
      draw();
      new ResizeObserver(() => { resize(); if (!moving()) draw(); }).observe(this);
      this.parentElement?.addEventListener('pointermove', (e) => {
        const r = this.getBoundingClientRect();
        mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top;
      });
      this.parentElement?.addEventListener('pointerleave', () => { mouse.x = mouse.y = -999; });
      // Recolor when the theme changes.
      new MutationObserver(() => requestAnimationFrame(() => { color = getComputedStyle(probe).color; if (!moving()) draw(); }))
        .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme', 'data-resolved-theme'] });
      // Pause when not visible.
      new IntersectionObserver(([e]) => {
        this.visible = e.isIntersecting;
        this.run();
      }).observe(this);
    }
    disconnectedCallback() { cancelAnimationFrame(this.raf); }
  }
  customElements.define('hero-canvas', HeroCanvas);
</script>

<style>
  hero-canvas {
    position: absolute;
    inset: 0;
    z-index: -1;
    mask-image: radial-gradient(ellipse at 70% 40%, black 20%, transparent 75%);
  }
  canvas { width: 100%; height: 100%; }
  .probe { display: none; color: var(--accent); }
</style>
