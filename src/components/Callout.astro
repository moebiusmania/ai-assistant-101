---
import Icon from './Icon.astro';

interface Props { type?: 'tip' | 'warn' | 'info' | 'key'; title?: string }
const { type = 'tip', title } = Astro.props;
const icons = { tip: 'lightbulb', warn: 'alert', info: 'info', key: 'sparkle' } as const;
---
<div class="callout" role="note" data-type={type}>
  <span class="callout-icon"><Icon name={icons[type]} /></span>
  <div>
    {title && <p class="callout-title">{title}</p>}
    <slot />
  </div>
</div>

<style>
  .callout {
    --c: var(--accent);
    --c-soft: var(--accent-soft);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius);
    background: var(--c-soft);
    border: 1px solid color-mix(in oklch, var(--c) 25%, transparent);
    margin-block: var(--space-5) !important;

    &[data-type='warn'] { --c: var(--coral-ink); --c-soft: var(--bad-soft); }
    &[data-type='info'] { --c: var(--teal-ink); --c-soft: light-dark(oklch(96% 0.03 190), oklch(28% 0.05 190)); }
    &[data-type='key'] { --c: var(--amber-ink); --c-soft: var(--warn-soft); }

    & > div > :global(* + *) { margin-block-start: var(--space-2); }
    & :global(p) { font-size: var(--step--1); line-height: 1.6; }
  }
  .callout-icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--bg-elev);
    color: var(--c);
    & :global(svg) { width: 1.2rem; height: 1.2rem; }
  }
  .callout-title { font-weight: 700; font-size: var(--step-0) !important; }
</style>
