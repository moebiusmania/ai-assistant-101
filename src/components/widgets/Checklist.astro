---
/** A checklist that remembers ticks on this device. */
import Widget from './Widget.astro';
import { getLang, t } from '../../i18n/ui';

interface Props { id: string; items: string[]; title?: string; hint?: string }
const lang = getLang(Astro.currentLocale);
const tr = t(lang);
const { id, items, title, hint } = Astro.props;
---
<check-list data-id={id}>
  <Widget label="Checklist" icon="check" title={title} hint={hint}>
    <ul>
      {items.map((it, i) => (
        <li><label><input type="checkbox" data-i={i} /><span class="box" aria-hidden="true"></span><span class="txt">{it}</span></label></li>
      ))}
    </ul>
    <p class="muted saved">{tr('w.saved')} · <b class="n">0</b>/{items.length}</p>
  </Widget>
</check-list>

<script>
  import { play } from '../../scripts/sound';
  import { read, write } from '../../scripts/storage';

  class CheckList extends HTMLElement {
    connectedCallback() {
      const key = `aic:check:${this.dataset.id}`;
      const boxes = [...this.querySelectorAll<HTMLInputElement>('input')];
      const state = read<number[]>(key, []);
      boxes.forEach((b, i) => (b.checked = state.includes(i)));
      const sync = () => {
        const on = boxes.flatMap((b, i) => (b.checked ? [i] : []));
        write(key, on);
        this.querySelector('.n')!.textContent = String(on.length);
        return on.length;
      };
      boxes.forEach((b) =>
        b.addEventListener('change', () => {
          const n = sync();
          play(n === boxes.length ? 'done' : b.checked ? 'pop' : 'tap');
        }),
      );
      sync();
    }
  }
  customElements.define('check-list', CheckList);
</script>

<style>
  check-list { display: block; }
  ul { list-style: none; padding: 0; display: grid; gap: var(--space-2); }
  label {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding: var(--space-3);
    border-radius: var(--radius);
    cursor: pointer;
    transition: background-color 150ms;
    &:hover { background: var(--bg-sunk); }
    &:has(input:focus-visible) { outline: 3px solid var(--accent); }
    & input { position: absolute; opacity: 0; pointer-events: none; }
  }
  .box {
    flex: none;
    width: 1.5rem; height: 1.5rem;
    border-radius: 50%;
    border: 2px solid var(--border-control);
    display: grid; place-items: center;
    transition: background-color 200ms, border-color 200ms, scale 300ms var(--ease-spring);
    &::after {
      content: '';
      width: 0.4rem; height: 0.7rem;
      border: solid var(--on-accent);
      border-width: 0 2.5px 2.5px 0;
      transform: rotate(45deg) scale(0);
      margin-block-start: -0.15rem;
      transition: transform 300ms var(--ease-spring);
    }
  }
  .txt { font-size: var(--step--1); transition: color 200ms; }
  label:has(input:checked) {
    & .box { background: var(--accent); border-color: var(--accent); scale: 1.1; &::after { transform: rotate(45deg) scale(1); } }
    & .txt { color: var(--text-muted); text-decoration: line-through; text-decoration-color: var(--accent); }
  }
  .saved { font-size: 0.8rem; margin-block-start: var(--space-3); }
</style>
