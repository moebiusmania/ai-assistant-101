---
/**
 * Shows how a language model writes: one word at a time, picking from
 * likely candidates. A "temperature" slider reshapes the probabilities.
 */
import Widget from './Widget.astro';
import Icon from '../Icon.astro';
import { getLang, t } from '../../i18n/ui';

type Step = { w: string; p: number }[];
interface Props { start: string; steps: Step[]; title?: string; hint?: string }

const lang = getLang(Astro.currentLocale);
const tr = t(lang);
const { start, steps, title, hint } = Astro.props;
const i18n = { done: lang === 'it' ? 'Frase completata! Prova di nuovo con un’altra temperatura.' : 'Sentence complete! Try again with a different temperature.' };
---
<next-word data-config={JSON.stringify({ start, steps })} data-i18n={JSON.stringify(i18n)}>
  <Widget label={lang === 'it' ? 'Prova tu' : 'Try it'} icon="brain" title={title} hint={hint}>
    <p class="sentence" aria-live="polite"><span class="text">{start}</span><span class="caret" aria-hidden="true"></span></p>
    <ol class="bars" aria-label={lang === 'it' ? 'Parole candidate' : 'Candidate words'}></ol>
    <div class="controls">
      <label class="temp">
        <span>{tr('w.temperature')}: <output>1.0</output></span>
        <input type="range" min="0.2" max="2" step="0.1" value="1" />
        <span class="scale"><span>{tr('w.low')}</span><span>{tr('w.high')}</span></span>
      </label>
      <div class="widget-actions">
        <button class="btn btn-primary next" type="button"><Icon name="play" />{tr('w.nextword')}</button>
        <button class="btn btn-ghost reset" type="button"><Icon name="refresh" />{tr('w.reset')}</button>
      </div>
    </div>
    <p class="feedback" data-kind="info" role="status"></p>
  </Widget>
</next-word>

<script>
  import { play } from '../../scripts/sound';
  import { data, reducedMotion, sleep, strings } from '../../scripts/ui';

  type Cfg = { start: string; steps: { w: string; p: number }[][] };

  class NextWord extends HTMLElement {
    cfg = data<Cfg>(this);
    i18n = strings(this);
    step = 0;
    temp = 1;
    busy = false;
    bars = this.querySelector<HTMLOListElement>('.bars')!;
    text = this.querySelector<HTMLElement>('.text')!;
    nextBtn = this.querySelector<HTMLButtonElement>('.next')!;
    fb = this.querySelector<HTMLElement>('.feedback')!;

    connectedCallback() {
      const range = this.querySelector<HTMLInputElement>('input[type=range]')!;
      const out = this.querySelector('output')!;
      range.addEventListener('input', () => {
        this.temp = Number(range.value);
        out.textContent = this.temp.toFixed(1);
        this.render();
      });
      this.nextBtn.addEventListener('click', () => void this.next());
      this.querySelector('.reset')!.addEventListener('click', () => this.reset());
      this.render();
    }

    probs(): { w: string; p: number }[] {
      const cands = this.cfg.steps[this.step] ?? [];
      const scaled = cands.map((c) => ({ w: c.w, p: Math.pow(c.p, 1 / this.temp) }));
      const sum = scaled.reduce((a, c) => a + c.p, 0);
      return scaled.map((c) => ({ w: c.w, p: c.p / sum }));
    }

    render() {
      const ps = this.probs();
      // Reuse existing rows so widths animate smoothly when the slider moves.
      if (this.bars.children.length !== ps.length || this.bars.dataset.step !== String(this.step)) {
        this.bars.dataset.step = String(this.step);
        this.bars.innerHTML = ps
          .map((c) => `<li><span class="word">${c.w}</span><span class="track"><span class="fill"></span></span><span class="pct"></span></li>`)
          .join('');
      }
      [...this.bars.children].forEach((li, i) => {
        const el = li as HTMLElement;
        el.style.setProperty('--p', String(ps[i].p));
        el.querySelector('.pct')!.textContent = `${Math.round(ps[i].p * 100)}%`;
      });
      this.nextBtn.disabled = this.step >= this.cfg.steps.length;
    }

    async next() {
      if (this.busy || this.step >= this.cfg.steps.length) return;
      this.busy = true;
      const ps = this.probs();
      let r = Math.random();
      let pick = ps.length - 1;
      for (let i = 0; i < ps.length; i++) {
        if ((r -= ps[i].p) <= 0) { pick = i; break; }
      }
      const rows = [...this.bars.children] as HTMLElement[];
      if (!reducedMotion()) {
        // Roulette: highlight hops between candidates, then settles.
        const hops = 8 + pick + ps.length;
        for (let h = 0; h <= hops; h++) {
          const idx = h === hops ? pick : h % ps.length;
          rows.forEach((row, i) => row.classList.toggle('hot', i === idx));
          play('tap');
          await sleep(40 + h * 9);
        }
      }
      rows.forEach((row, i) => row.classList.toggle('hot', i === pick));
      rows[pick].classList.add('picked');
      play('pop');
      await sleep(350);
      const span = document.createElement('span');
      span.className = 'new';
      span.textContent = ' ' + ps[pick].w;
      this.text.append(span);
      this.step++;
      if (this.step >= this.cfg.steps.length) {
        this.fb.textContent = this.i18n.done;
        this.bars.innerHTML = '';
        play('ok');
      }
      this.render();
      this.busy = false;
      // Focus would be lost on the now-disabled button.
      if (this.nextBtn.disabled) this.querySelector<HTMLButtonElement>('.reset')!.focus();
    }

    reset() {
      this.step = 0;
      this.text.textContent = this.cfg.start;
      this.fb.textContent = '';
      this.bars.innerHTML = '';
      this.render();
      play('tap');
    }
  }
  customElements.define('next-word', NextWord);
</script>

<style>
  next-word { display: block; }
  .sentence {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.3;
    padding: var(--space-4);
    background: var(--bg-sunk);
    border-radius: var(--radius);
    min-height: 4.5rem;
    & :global(.new) {
      color: var(--accent);
      display: inline-block;
      white-space: pre;
      animation: drop-in 500ms var(--ease-spring);
    }
  }
  @keyframes drop-in {
    from { opacity: 0; transform: translateY(-14px) scale(1.2); }
  }
  .caret {
    display: inline-block;
    width: 3px;
    height: 1em;
    margin-inline-start: 4px;
    vertical-align: -0.12em;
    background: var(--accent);
    /* Blinks for 4s only: endless blinking would need a pause control (WCAG 2.2.2). */
    animation: caret 1s steps(1) 4;
  }
  @keyframes caret { 50% { opacity: 0; } }

  .bars {
    list-style: none;
    padding: 0;
    margin-block: var(--space-4);
    display: grid;
    gap: var(--space-2);
    & :global(li) {
      display: grid;
      grid-template-columns: 7.5rem 1fr 3.2rem;
      align-items: center;
      gap: var(--space-3);
      padding: 0.3rem 0.5rem;
      border-radius: var(--radius-sm);
      transition: background-color 120ms;
      animation: fade-up 300ms var(--ease-out) both;
    }
    & :global(li:nth-child(2)) { animation-delay: 50ms; }
    & :global(li:nth-child(3)) { animation-delay: 100ms; }
    & :global(li:nth-child(4)) { animation-delay: 150ms; }
    & :global(li.hot) { background: var(--accent-soft); }
    & :global(li.picked .fill) { background: linear-gradient(90deg, var(--accent), var(--teal)); }
    & :global(.word) { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    & :global(.track) { height: 0.75rem; background: var(--bg-sunk); border-radius: 99px; overflow: hidden; }
    & :global(.fill) {
      display: block;
      height: 100%;
      width: calc(var(--p) * 100%);
      background: color-mix(in oklch, var(--accent) 65%, var(--bg-elev));
      border-radius: inherit;
      transition: width 400ms var(--ease-out);
    }
    & :global(.pct) { text-align: end; font-variant-numeric: tabular-nums; color: var(--text-muted); font-size: var(--step--1); }
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: end;
    justify-content: space-between;
    & .widget-actions { margin: 0; }
  }
  .temp {
    display: grid;
    gap: var(--space-1);
    font-size: var(--step--1);
    font-weight: 600;
    min-width: min(100%, 16rem);
    & output { color: var(--accent); font-variant-numeric: tabular-nums; }
    & .scale { display: flex; justify-content: space-between; font-weight: 400; color: var(--text-muted); font-size: 0.8rem; }
  }
  input[type='range'] {
    accent-color: var(--accent);
    width: 100%;
  }
  @container (width < 28rem) {
    .bars :global(li) { grid-template-columns: 5.5rem 1fr 2.8rem; }
  }
</style>
