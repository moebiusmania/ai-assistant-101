---
/** A ready-to-use prompt template with highlighted [placeholders] and a copy button. */
import Icon from '../Icon.astro';
import { format } from '../../lib/format';
import { getLang, t } from '../../i18n/ui';

interface Props { title: string; icon?: string; prompt: string; when?: string }
const lang = getLang(Astro.currentLocale);
const tr = t(lang);
const { title, icon = 'sparkle', prompt, when } = Astro.props;
---
<copy-prompt class="cp" data-copied={tr('w.copied')}>
  <header>
    <span class="ic"><Icon name={icon} /></span>
    <div>
      <h3>{title}</h3>
      {when && <p class="when">{when}</p>}
    </div>
    <button type="button" class="btn btn-sm copy"><Icon name="copy" /><span class="label">{tr('w.copy')}</span><span class="visually-hidden">: {title}</span></button>
  </header>
  <p class="visually-hidden status" role="status"></p>
  <div class="body" set:html={format(prompt)} />
  <textarea hidden>{prompt}</textarea>
</copy-prompt>

<script>
  import { play } from '../../scripts/sound';

  class CopyPrompt extends HTMLElement {
    connectedCallback() {
      const btn = this.querySelector<HTMLButtonElement>('.copy')!;
      const label = btn.querySelector('.label')!;
      const status = this.querySelector('.status')!;
      const original = label.textContent;
      btn.addEventListener('click', async () => {
        const text = this.querySelector('textarea')!.value;
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const ta = this.querySelector('textarea')!;
          ta.hidden = false; ta.select(); document.execCommand('copy'); ta.hidden = true;
        }
        label.textContent = this.dataset.copied!;
        status.textContent = this.dataset.copied!;
        btn.classList.add('done');
        play('ok');
        setTimeout(() => { label.textContent = original; status.textContent = ''; btn.classList.remove('done'); }, 1800);
      });
    }
  }
  customElements.define('copy-prompt', CopyPrompt);
</script>

<style>
  .cp {
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: box-shadow 250ms, transform 250ms var(--ease-out);
    &:hover { box-shadow: var(--shadow); transform: translateY(-2px); }
  }
  header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-4);
    border-block-end: 1px solid var(--border);
  }
  .ic {
    display: grid; place-items: center;
    width: 2.5rem; height: 2.5rem;
    border-radius: 0.75rem;
    background: var(--accent-soft);
    color: var(--accent);
    & :global(svg) { width: 1.25rem; height: 1.25rem; }
  }
  h3 { font-size: var(--step-0); margin: 0; }
  .when { font-size: 0.8rem; color: var(--text-muted); line-height: 1.4; margin-block-start: 0.15em; }
  .copy.done { --btn-bg: var(--ok-soft); --btn-border: var(--ok); }
  .body {
    padding: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.65;
    background: var(--bg-sunk);
    & :global(* + *) { margin-block-start: 0.6em; }
    & :global(ul), & :global(ol) { padding-inline-start: 1.3em; }
    & :global(.ph) { background: var(--warn-soft); color: inherit; border-radius: 0.3em; padding-inline: 0.15em; outline: 1px dashed color-mix(in oklch, var(--amber) 60%, transparent); }
  }
</style>
