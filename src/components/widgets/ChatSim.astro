---
/**
 * A product-neutral fake chat that plays itself when scrolled into view.
 * Usage: <ChatSim messages={[{ from: 'user', text: '…' }, { from: 'ai', text: '…' }]} />
 */
import Widget from './Widget.astro';
import Icon from '../Icon.astro';
import { format, wordCount } from '../../lib/format';
import { getLang, t, pick } from '../../i18n/ui';

type Msg = { from: 'user' | 'ai'; text: string; note?: string };
interface Props { messages: Msg[]; label?: string; title?: string; hint?: string; bare?: boolean }

const lang = getLang(Astro.currentLocale);
const tr = t(lang);
const { messages, label = pick(lang, { it: 'Esempio di chat', en: 'Chat example', es: 'Ejemplo de chat' }), title, hint, bare = false } = Astro.props;
const rendered = messages.map((m) => {
  const html = format(m.text, { stream: m.from === 'ai' });
  return { ...m, html, words: wordCount(html) };
});
---
<chat-sim class:list={[{ bare }]}>
  <Widget label={label} icon="chat" title={title} hint={hint}>
    <div class="chat" role="log" aria-live="polite">
      {rendered.map((m) => (
        <div class="msg" data-from={m.from} data-words={m.words}>
          <span class="avatar" aria-hidden="true">{m.from === 'user' ? tr('w.you').charAt(0) : <Icon name="sparkle" />}</span>
          <div class="bubble">
            <span class="visually-hidden">{m.from === 'user' ? tr('w.you') : tr('w.ai')}: </span>
            <Fragment set:html={m.html} />
            {m.note && <p class="note"><Icon name="info" size={16} />{m.note}</p>}
          </div>
        </div>
      ))}
      <div class="typing" aria-hidden="true"><span></span><span></span><span></span></div>
    </div>
    <div class="widget-actions">
      <button class="btn btn-sm btn-ghost replay" type="button"><Icon name="refresh" />{tr('w.replay')}</button>
    </div>
  </Widget>
</chat-sim>

<script>
  import { play } from '../../scripts/sound';
  import { reducedMotion, sleep } from '../../scripts/ui';

  class ChatSim extends HTMLElement {
    #run = 0;

    connectedCallback() {
      this.querySelector('.replay')!.addEventListener('click', () => void this.play());
      if (reducedMotion()) return;
      this.classList.add('armed');
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          void this.play();
        }
      }, { threshold: 0.35 });
      io.observe(this);
    }

    async play() {
      const run = ++this.#run;
      const msgs = [...this.querySelectorAll<HTMLElement>('.msg')];
      const typing = this.querySelector<HTMLElement>('.typing')!;
      msgs.forEach((m) => m.classList.remove('shown', 'streaming'));
      if (reducedMotion()) {
        msgs.forEach((m) => m.classList.add('shown'));
        return;
      }
      for (const m of msgs) {
        if (run !== this.#run) return;
        if (m.dataset.from === 'ai') {
          m.before(typing);
          typing.classList.add('on');
          await sleep(900);
          typing.classList.remove('on');
          m.classList.add('shown', 'streaming');
          const words = Number(m.dataset.words);
          for (let i = 0; i < words && run === this.#run; i += 3) {
            if (i % 6 === 0) play('type');
            await sleep(70);
          }
          await sleep(300);
        } else {
          await sleep(250);
          m.classList.add('shown');
          play('pop');
          await sleep(600);
        }
      }
    }
  }
  customElements.define('chat-sim', ChatSim);
</script>

<style>
  chat-sim { display: block; }
  chat-sim.bare :global(.widget) { box-shadow: none; margin-block: 0 !important; }

  .chat {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--bg-sunk);
    border-radius: var(--radius);
    min-height: 6rem;
  }

  .msg {
    display: flex;
    gap: var(--space-2);
    align-items: flex-end;
    max-width: 92%;
    &[data-from='user'] { flex-direction: row-reverse; align-self: flex-end; }
  }
  .avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    font-size: 0.8rem;
    font-weight: 700;
    background: var(--border);
    color: var(--text-muted);
    & :global(svg) { width: 1rem; height: 1rem; }
  }
  .msg[data-from='ai'] .avatar {
    background: linear-gradient(135deg, var(--accent), var(--teal));
    color: white;
  }
  .bubble {
    padding: var(--space-3) var(--space-4);
    border-radius: 1.1rem;
    font-size: var(--step--1);
    line-height: 1.55;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-end-start-radius: 0.3rem;
    & :global(p + p), & :global(p + ul), & :global(ul + p), & :global(p + ol), & :global(ol + p) { margin-block-start: 0.6em; }
    & :global(ul), & :global(ol) { padding-inline-start: 1.2em; display: grid; gap: 0.2em; }
    & :global(.ph) { background: var(--warn-soft); color: inherit; border-radius: 0.3em; padding-inline: 0.2em; }
  }
  .msg[data-from='user'] .bubble {
    background: var(--accent);
    color: var(--on-accent);
    border-color: transparent;
    border-end-start-radius: 1.1rem;
    border-end-end-radius: 0.3rem;
    & :global(.ph) { background: color-mix(in oklch, white 25%, transparent); }
  }
  .note {
    display: flex;
    gap: 0.4em;
    align-items: flex-start;
    margin-block-start: 0.6em;
    padding-block-start: 0.6em;
    border-block-start: 1px dashed var(--border-strong);
    color: var(--text-muted);
    font-size: 0.85em;
    & :global(svg) { flex: none; margin-block-start: 0.2em; }
  }

  /* Armed = JS is running the animation; hide until played. */
  chat-sim.armed .msg { display: none; }
  chat-sim.armed .msg.shown { display: flex; animation: bubble-in 420ms var(--ease-spring) both; }
  @keyframes bubble-in {
    from { opacity: 0; transform: translateY(10px) scale(0.96); }
  }
  chat-sim.armed .msg.streaming :global(.w) {
    animation: word-in 250ms ease-out both;
    animation-delay: calc(var(--i) * 23ms);
  }
  @keyframes word-in {
    from { opacity: 0; filter: blur(3px); }
  }

  .typing {
    display: none;
    gap: 4px;
    align-self: flex-start;
    padding: 0.8rem 1rem;
    margin-inline-start: 2.5rem;
    border-radius: 1rem;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    &.on { display: inline-flex; }
    & span {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--text-muted);
      animation: dot 1s infinite ease-in-out;
      &:nth-child(2) { animation-delay: 0.15s; }
      &:nth-child(3) { animation-delay: 0.3s; }
    }
  }
  @keyframes dot {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-5px); opacity: 1; }
  }
</style>
